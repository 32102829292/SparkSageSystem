{
  "version": 2,
  "builds": [
    {
      "src": "api/health.py",
      "use": "@vercel/python",
      "config": { "runtime": "python3.9", "launcherType": "asgi" }
    },
    {
      "src": "api/main.py",
      "use": "@vercel/python",
      "config": { "runtime": "python3.9", "launcherType": "asgi" }
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "api/health.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/main.py"
    }
  ]
}